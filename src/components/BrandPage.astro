---
// The brand guidelines, in either language (src/pages/brand.astro and src/pages/en/brand.astro).
import Base from '../layouts/Base.astro';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { colours } from '../data/brand';
import { shop } from '../data/shop';
import { copy, type Lang } from '../i18n/copy';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy[lang];
const g = t.brand;
---
<Base lang={lang} path="/brand/" title={t.meta.brandTitle} description={t.meta.brandDescription}>
  <header class="wrap bh">
    <h1 class="poster bh__title">{g.title}</h1>
    <p class="lead">{g.lead}</p>
  </header>

  <section class="wrap blk" aria-labelledby="mark-title">
    <h2 id="mark-title" class="h2">{g.markTitle}</h2>
    <p class="blk__lead">{g.markLead}</p>
    <div class="marks">
      <div class="tile tile--blue"><Logo variant="mark" label={g.markOnBlue} class="tile__mark" /></div>
      <div class="tile tile--ink"><Logo variant="mark" label={g.markOnInk} class="tile__mark" /></div>
    </div>
    <div class="lockups">
      <div class="tile tile--blue tile--wide"><Logo variant="horizontal" class="lock lock--h" /></div>
      <div class="tile tile--ink"><Logo variant="stacked" class="lock lock--s" /></div>
    </div>
    <ul class="rules" role="list">
      {g.rules.map(([k, v]) => <li><strong>{k}</strong> {v}</li>)}
    </ul>
    <div class="dl">
      <a class="pill" href="/brand/barber-bros-mark.svg" download><Icon name="download-simple" /> {g.dlMark}</a>
      <a class="pill" href="/brand/barber-bros-logo.svg" download><Icon name="download-simple" /> {g.dlLogo}</a>
      <a class="pill" href="/brand/favicon.svg" download><Icon name="download-simple" /> {g.dlIcon}</a>
    </div>
  </section>

  <section class="wrap blk" aria-labelledby="col-title">
    <h2 id="col-title" class="h2">{g.coloursTitle}</h2>
    <div class="swatches">
      {colours.map((c) => (
        <div class={`sw sw--${c.key}`}>
          <p class="sw__name">{c.name[lang]}</p>
          <dl class="sw__codes"><div><dt>HEX</dt><dd>{c.hex}</dd></div><div><dt>RGB</dt><dd>{c.rgb}</dd></div></dl>
          <p class="sw__role">{c.role[lang]}</p>
        </div>
      ))}
    </div>
    <p class="blk__lead">{g.coloursLead}</p>
  </section>

  <section class="wrap blk" aria-labelledby="type-title">
    <h2 id="type-title" class="h2">{g.typeTitle}</h2>
    <div class="type">
      <div>
        <p class="type__spec type__spec--display">Barber Bros 0123456789</p>
        <p><strong>{g.displaySpec}</strong>{g.displayNote}</p>
      </div>
      <div>
        <p class="type__spec type__spec--text">{g.textSample}</p>
        <p><strong>Schibsted Grotesk</strong>{g.textNote}</p>
      </div>
    </div>
  </section>

  <section class="wrap blk" aria-labelledby="app-title">
    <h2 id="app-title" class="h2">{g.useTitle}</h2>
    <div class="apps">
      <figure class="app">
        <div class="sign" aria-hidden="true">
          <div class="sign__board"><Logo variant="stacked" label="" class="sign__logo" /></div>
        </div>
        <figcaption>{g.signCaption}</figcaption>
      </figure>
      <figure class="app">
        <div class="cards" aria-hidden="true">
          <div class="card card--front"><Logo variant="horizontal" label="" class="card__logo" /></div>
          <div class="card card--back"><span class="card__t">{g.cardBack}</span><span class="card__n">{shop.phone}</span></div>
        </div>
        <figcaption>{g.cardCaption}</figcaption>
      </figure>
    </div>
  </section>
</Base>

<style>
  .bh { display: grid; gap: var(--space-m); padding-block: var(--space-2xl) var(--space-l); }
  .bh__title { font-size: clamp(5rem, 2rem + 16vw, 16rem); }
  .blk { padding-block-start: var(--space-section); display: grid; gap: var(--space-l); }
  .blk__lead { max-inline-size: 58ch; font-size: var(--step-1); line-height: 1.4; }
  .marks { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr)); gap: var(--space-m); }
  .lockups { display: grid; gap: var(--space-m); grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr)); }
  @media (min-width: 900px) { .lockups { grid-template-columns: 2fr 1fr; } }
  .tile { display: grid; place-items: center; min-block-size: 18rem; border: 3px solid var(--ink); padding: var(--space-l); }
  .tile--blue { background: var(--blue); color: var(--ink); }
  .tile--ink { background: var(--ink); color: var(--blue); }
  .tile :global(.tile__mark) { block-size: 10rem; }
  .tile :global(.lock--h) { font-size: clamp(2.5rem, 1.5rem + 4vw, 6rem); }
  .tile :global(.lock--s) { font-size: clamp(2.5rem, 1.5rem + 2.5vw, 4rem); }
  .rules { padding: 0; list-style: none; display: grid; gap: 0.6rem; max-inline-size: 62ch; }
  .rules li { padding-block-start: 0.6rem; border-block-start: 1.5px solid var(--line); }
  .dl { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .swatches { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr)); gap: var(--space-m); }
  .sw { min-block-size: 20rem; padding: var(--space-l); border: 3px solid var(--ink); display: grid; align-content: space-between; gap: var(--space-m); }
  .sw--blue { background: var(--blue); color: var(--ink); }
  .sw--ink { background: var(--ink); color: var(--blue); }
  .sw__name { font-family: var(--display); font-weight: 900; text-transform: uppercase; font-size: clamp(3rem, 2rem + 4vw, 6rem); line-height: 0.85; }
  .sw__codes { display: flex; gap: 2rem; margin: 0; font-variant-numeric: tabular-nums; }
  .sw__codes dt { font-size: var(--step--1); }
  .sw__codes dd { margin: 0; font-weight: 650; }
  .sw__role { max-inline-size: 38ch; }
  .type { display: grid; gap: var(--space-xl); }
  .type p + p { margin-block-start: 0.6rem; max-inline-size: 60ch; }
  .type__spec--display { font-family: var(--display); font-weight: 900; text-transform: uppercase; font-size: clamp(3rem, 1.5rem + 7vw, 9rem); line-height: 0.85; }
  .type__spec--text { font-size: var(--step-3); line-height: 1.3; max-inline-size: 28ch; }
  .apps { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(24rem, 100%), 1fr)); gap: var(--space-l); }
  .app { margin: 0; display: grid; gap: 0.75rem; }
  .app figcaption { font-size: var(--step--1); color: var(--fg-2); }
  .sign { aspect-ratio: 3 / 2; background: var(--ink); display: grid; padding: 7%; }
  .sign__board { display: grid; place-items: center; background: var(--blue); color: var(--ink); outline: 5px solid var(--ink); outline-offset: -14px; }
  .sign :global(.sign__logo) { font-size: clamp(2rem, 1.2rem + 2.6vw, 3.6rem); }
  .cards { aspect-ratio: 3 / 2; display: grid; grid-template-columns: 1fr 1fr; gap: 6%; align-items: center; padding: 4%; background: var(--deep); }
  .card { aspect-ratio: 85 / 55; display: grid; place-items: center; padding: 8%; }
  .card--front { background: var(--blue); color: var(--ink); transform: rotate(-4deg); }
  .card--back { background: var(--ink); color: var(--blue); transform: rotate(3deg); align-content: center; gap: 0.3rem; text-align: center; }
  .card :global(.card__logo) { font-size: clamp(1rem, 0.6rem + 1.2vw, 1.6rem); }
  .card__t { font-family: var(--display); font-weight: 900; text-transform: uppercase; font-size: clamp(0.9rem, 0.6rem + 0.9vw, 1.3rem); }
  .card__n { font-size: 0.7rem; }
</style>
