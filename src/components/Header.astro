---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import OpenStatus from './OpenStatus.astro';
import { shop, whatsappHref, callHref } from '../data/shop';
import { copy, localePath, type Lang } from '../i18n/copy';

interface Props { lang: Lang; path?: string }
const { lang, path = '/' } = Astro.props;
const t = copy[lang];
const home = localePath(lang, '/');
---
<div class="topbar">
  <div class="topbar__in wrap">
    <OpenStatus lang={lang} />
    <span class="topbar__preview">{t.bar.preview}</span>
    <nav class="langs" aria-label={t.bar.language}>
      {(['sq', 'en'] as const).map((l) => (
        <a href={localePath(l, path)} hreflang={l} lang={l} aria-current={l === lang ? 'page' : undefined}><span aria-hidden="true">{l.toUpperCase()}</span><span class="visually-hidden">{t.bar.names[l]}</span></a>
      ))}
    </nav>
  </div>
</div>
<header class="bar">
  <div class="bar__in wrap">
    <a href={home} class="bar__logo" aria-label={t.nav.home}><Logo label="Barber Bros" /></a>
    <nav class="bar__nav" aria-label={t.nav.label}>
      <a href={`${home}#${t.ids.prices}`}>{t.nav.prices}</a>
      <a href={`${home}#${t.ids.work}`}>{t.nav.work}</a>
      <a href={`${home}#${t.ids.barbers}`}>{t.nav.barbers}</a>
      <a href={`${home}#${t.ids.visit}`}>{t.nav.visit}</a>
    </nav>
    <div class="bar__act">
      <a class="pill pill--solid" href={whatsappHref(lang)} target="_blank" rel="noopener"><Icon name="whatsapp-logo" /><span>{t.cta.book}<span class="bar__long">{t.cta.bookLong}</span></span><span class="visually-hidden">{t.cta.opens}</span></a>
      <a class="pill bar__call" href={callHref()} aria-label={`${t.cta.call} ${shop.phone}`}><Icon name="phone" /><span class="bar__long">{t.cta.call}</span></a>
      <button class="pill switch bar__stop" type="button" aria-pressed="false" data-motion-toggle><span>{t.cta.stop}<span class="bar__long">{t.cta.stopLong}</span></span><span class="track" aria-hidden="true"></span></button>
    </div>
  </div>
</header>

<style>
  /* the ink strip: open-now status, preview tag, language switch */
  .topbar { background: var(--ink); color: var(--blue); font-size: 0.85rem; }
  .topbar__in { display: flex; align-items: center; gap: var(--space-s); min-block-size: 44px; }
  .topbar__preview { margin-inline-start: auto; font-family: var(--display); font-weight: 800; font-size: 0.8rem; letter-spacing: 0.06em; text-transform: uppercase; border: 1.5px solid currentColor; padding: 0.05rem 0.45rem; }
  .langs { display: flex; margin-inline-end: -0.7rem; }
  .langs a { display: inline-grid; place-items: center; min-inline-size: 44px; min-block-size: 44px; font-family: var(--display); font-weight: 800; font-size: 1rem; letter-spacing: 0.04em; text-decoration: none; }
  .langs a[aria-current] { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.3em; }
  @media (hover: hover) and (pointer: fine) { .langs a:not([aria-current]):hover { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.3em; } }
  .topbar :focus-visible { outline-color: var(--blue); box-shadow: 0 0 0 7px var(--ink); }
  @media (max-width: 520px) { .topbar__preview { display: none; } .langs { margin-inline-start: auto; } }

  .bar { position: sticky; top: 0; z-index: 50; background: var(--blue); border-block-end: 2px solid transparent; transition: border-color 200ms ease; }
  :global(html[data-scrolled]) .bar { border-block-end-color: var(--ink); }
  .bar__in { display: flex; align-items: center; gap: var(--space-s); min-block-size: var(--header-h); }
  .bar__logo { display: inline-flex; align-items: center; min-block-size: 44px; min-inline-size: 44px; font-size: 1.9rem; text-decoration: none; margin-inline-end: auto; }
  .bar__nav { display: flex; gap: 1.4rem; font-family: var(--display); font-weight: 800; font-size: 1.15rem; text-transform: uppercase; letter-spacing: 0.02em; }
  .bar__nav a { text-decoration: none; min-block-size: 44px; display: inline-flex; align-items: center; }
  @media (hover: hover) and (pointer: fine) { .bar__nav a:hover { text-decoration: underline; text-decoration-thickness: 2px; } }
  .bar__act { display: flex; gap: 0.4rem; align-items: center; }
  @media (max-width: 1000px) { .bar__nav { display: none; } }
  @media (max-width: 640px) {
    .bar__logo { font-size: 1.45rem; }
    .bar__long { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .bar__call { inline-size: 44px; padding: 0; }
    .bar__stop { padding-inline: 0.75rem; }
    .bar__act .pill { padding-inline: 0.85rem; }
  }
  @media (max-width: 400px) { .bar__logo :global(.bb-word) { display: none; } }
</style>
